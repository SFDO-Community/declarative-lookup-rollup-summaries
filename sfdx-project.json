{
  "packageDirectories": [
    {
      "path": "dlrs/libs/fflib-apexmocks"
    },
    {
      "path": "dlrs/libs/fflib-common"
    },
    {
      "path": "dlrs/libs/lrengine"
    },
    {
      "path": "dlrs/libs/metadataservice"
    },
    {
      "path": "dlrs/main"
    },
    {
      "path": "dlrs/default",
      "default": true
    },
    {
      "path": "unpackaged/config/test"
    }
  ],
  "replacements": [
    {
      "glob": "unpackaged/config/test/**",
      "stringToReplace": "dlrs.",
      "replaceWithEnv": "NAMESPACE_DOT",
      "allowUnsetEnvVariable": true
    },
    {
      "glob": "unpackaged/config/test/**",
      "stringToReplace": "dlrs__",
      "replaceWithEnv": "NAMESPACE_DOUBLE_UNDER",
      "allowUnsetEnvVariable": true
    }
  ],
  "namespace": "dlrs",
  "sfdcLoginUrl": "https://login.salesforce.com",
  "sourceApiVersion": "66.0"
}
