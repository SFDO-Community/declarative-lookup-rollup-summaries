<apex:page standardController="LookupRollupSummary__c" extensions="RollupController" sidebar="false" lightningStylesheets="true">
	<apex:form id="form">
		<apex:sectionHeader title="Lookup Rollup Summary" subtitle="Manage Apex Trigger for {!RollupSummary.ChildObject}" />
		<apex:pageMessages escape="false" />
		<apex:actionPoller action="{!checkAsyncRequest}" interval="5" rerender="form" rendered="{!NOT(ISNULL(deployRequestResult))}" />
		<apex:outputPanel id="code">
			<apex:pageBlock>
				<apex:pageBlockButtons>
					<apex:outputPanel rendered="{!ISNULL(deployRequestResult)}">
							<apex:commandButton value="{!IF(Deployed, 'Remove', 'Deploy')}" action="{!deployZip}" />
							<apex:commandButton value="Cancel" action="{!cancel}" />
					</apex:outputPanel>
				</apex:pageBlockButtons>
				<apex:pageBlockSection rendered="{!ParentMergeable && NOT(Deployed) && ISNULL(deployRequestResult)}">
					<apex:pageBlockSectionItem>
						<apex:outputLabel value="Deploy code to support record merging?" />
						<apex:inputCheckbox value="{!ParentTriggerRequired}">
							<apex:actionSupport event="onclick" reRender="code" />
						</apex:inputCheckbox>
					</apex:pageBlockSectionItem>
					<apex:pageBlockSectionItem>
					</apex:pageBlockSectionItem>
				</apex:pageBlockSection>
					<apex:repeat value="{!apexCodeToDisplay}" var="string" id="theRepeat">
						<apex:pageBlockSection>
							<pre>{!string}</pre>
						</apex:pageBlockSection>
					</apex:repeat>
			</apex:pageBlock>
		</apex:outputPanel>
	</apex:form>
</apex:page>